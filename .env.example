# WhatsApp Bot Configuration
# Copy this to .env and fill in the values

# Port for the HTTP API server
WA_BOT_PORT=3002

# Secret key for authenticating API requests between backend and bot
# Generate a strong random string for production
WA_BOT_SECRET=your-secret-key-here

# WhatsApp Bot URL (used by backend to call bot API)
WHATSAPP_BOT_URL=http://localhost:3002

# Same secret as WA_BOT_SECRET (used by backend)
WHATSAPP_BOT_SECRET=your-secret-key-here

# Node environment
NODE_ENV=development
